{
  "name": "bms",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=http-server --filter=web-server --filter=web",
    "dev:all": "turbo run dev",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:init": "pnpm --filter @repo/db exec prisma db init",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "^2.11.7",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  }
}
